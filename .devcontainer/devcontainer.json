{
    "name": "Budget App",
    "service": "budget_app",
    "initializeCommand": "/bin/bash ./.devcontainer/initialize-script.sh",
    "features": {
        "ghcr.io/schlich/devcontainer-features/starship:0": {},
        "ghcr.io/schlich/devcontainer-features/playwright:0": {
            "browsers": "chromium"
        }
    },
    "dockerComposeFile": "docker-compose.yml",
    "remoteUser": "node",
    "updateRemoteUserUID": true,
    "forwardPorts": [
        3001
    ],
    "workspaceFolder": "/budget-app",
    "customizations": {
        "vscode": {
            "extensions": [
                "biomejs.biome",
                "ms-playwright.playwright",
                "irongeek.vscode-env"
            ]
        }
    }
}
